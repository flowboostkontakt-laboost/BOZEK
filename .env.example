# ─── Baza danych (PostgreSQL + pgvector) ─────────────────────────────
DATABASE_URL="postgresql://sep:sep@localhost:5432/sep?schema=public"

# ─── Autoryzacja (JWT) ───────────────────────────────────────────────
JWT_ACCESS_SECRET="zmien_mnie_na_dlugi_losowy_ciag"
JWT_REFRESH_SECRET="zmien_mnie_na_inny_dlugi_losowy_ciag"
JWT_ACCESS_TTL="30m"
JWT_REFRESH_TTL="7d"

# Strefa czasu serwera — z niej liczą się dni w kalendarzu i statystykach.
TZ="Europe/Warsaw"

# ─── Integracja PrestaShop (Webservice API) ──────────────────────────
PRESTASHOP_API_URL="https://twojsklep.pl/api"
PRESTASHOP_API_KEY="zmien_mnie"
# Godzina dobowej synchronizacji (cron), format HH:MM
SYNC_CRON_TIME="03:00"

# ─── Moduł AI rozpoznawania ze zdjęcia (Wariant A) ───────────────────
# gemini = Google AI Studio / Gemini API (multimodalny embedding, zwykły klucz)
# cohere = Cohere Embed
# local  = zaślepka bez modelu (moduł zgłasza się jako wyłączony)
# Uwaga: OpenAI NIE udostępnia embeddingów obrazu — nie da się go tu użyć.
AI_PROVIDER="gemini"
AI_API_KEY=""
# Opcjonalne nadpisania — puste = domyślne dla wybranego dostawcy.
AI_EMBED_MODEL=""
AI_EMBED_URL=""
# Liczba wymiarów wektora (Gemini: 128–3072; 768 to dobry kompromis).
AI_EMBED_DIM="768"
# Próg pewności dopasowania (0-1). Poniżej → pozycja trafia do kolejki "Do sprawdzenia".
AI_MATCH_THRESHOLD="0.78"

# ─── Serwer / API ────────────────────────────────────────────────────
PORT="3000"
WEB_ORIGIN="http://localhost:5173"
